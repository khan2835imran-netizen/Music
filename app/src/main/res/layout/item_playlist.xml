<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="78dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="8dp"
 android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp" android:background="@drawable/bg_card">
 <ImageView android:id="@+id/icon" android:layout_width="56dp" android:layout_height="56dp" android:padding="16dp" android:background="@drawable/bg_artwork" android:src="@drawable/ic_playlist" android:contentDescription="@null"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
  <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" android:maxLines="1"/>
  <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="3dp"/>
 </LinearLayout>
 <ImageButton android:id="@+id/delete" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/ic_delete" android:padding="11dp" android:contentDescription="Delete playlist"/>
</LinearLayout>