<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp" android:background="@color/background">
 <View android:layout_width="280dp" android:layout_height="280dp" android:layout_marginTop="42dp" android:background="@drawable/artwork_bg"/>
 <TextView android:id="@+id/trackTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nothing playing" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="28dp"/>
 <TextView android:id="@+id/trackArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a song" android:textColor="@color/text_secondary" android:textSize="15sp" android:gravity="center" android:layout_marginTop="6dp"/>
 <SeekBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="12dp">
  <Button android:id="@+id/shuffle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shuffle"/>
  <Button android:id="@+id/previous" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prev"/>
  <Button android:id="@+id/playPause" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Play"/>
  <Button android:id="@+id/next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next"/>
  <Button android:id="@+id/repeat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Repeat"/>
 </LinearLayout>
</LinearLayout>