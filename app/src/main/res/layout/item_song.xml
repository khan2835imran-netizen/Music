<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="78dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="5dp"
 android:background="@drawable/bg_card" android:padding="9dp">
 <ImageView android:id="@+id/artwork" android:layout_width="58dp" android:layout_height="58dp" android:scaleType="centerCrop" android:background="@drawable/bg_artwork" android:contentDescription="@null" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
